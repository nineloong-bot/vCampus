<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_DIR" value="logs"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%date %-5level [%thread] %logger{36} - %msg%n</pattern></encoder>
    </appender>
    <appender name="SERVER" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/server.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/server.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <encoder><pattern>%date %-5level [%thread] %logger - %msg%n</pattern></encoder>
    </appender>
    <appender name="BUSINESS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/business.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/business.%d{yyyy-MM-dd}.log.gz</fileNamePattern><maxHistory>14</maxHistory>
        </rollingPolicy><encoder><pattern>%date %-5level [%thread] %logger - %msg%n</pattern></encoder>
    </appender>
    <appender name="SECURITY" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/security.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/security.%d{yyyy-MM-dd}.log.gz</fileNamePattern><maxHistory>14</maxHistory>
        </rollingPolicy><encoder><pattern>%date %-5level [%thread] %logger - %msg%n</pattern></encoder>
    </appender>
    <appender name="DATABASE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/database.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/database.%d{yyyy-MM-dd}.log.gz</fileNamePattern><maxHistory>14</maxHistory>
        </rollingPolicy><encoder><pattern>%date %-5level [%thread] %logger - %msg%n</pattern></encoder>
    </appender>
    <logger name="vcampus.business" level="INFO" additivity="false"><appender-ref ref="BUSINESS"/></logger>
    <logger name="vcampus.security" level="INFO" additivity="false"><appender-ref ref="SECURITY"/></logger>
    <logger name="vcampus.database" level="INFO" additivity="false"><appender-ref ref="DATABASE"/></logger>
    <root level="INFO"><appender-ref ref="CONSOLE"/><appender-ref ref="SERVER"/></root>
</configuration>
